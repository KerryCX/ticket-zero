{
  "name": "case-management-service",
  "version": "1.0.0",
  "description": "TicketZero: a RESTful support ticket API with a GTD-inspired workflow",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm install --prefix client && npm run build --prefix client && tsc",
    "build:api": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.18.2",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "jest": "^30.5.2",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
